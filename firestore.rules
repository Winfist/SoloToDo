rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin function to check UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == '4FPoiwjIDneGrJqgYDZLPbPOJZu2';
    }

    // Admin Override: Allow full access to UID 4FPoiwjIDneGrJqgYDZLPbPOJZu2
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection - each user can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // Quest history subcollection (Hybrid Storage)
      match /questHistory/{questId} {
        allow read, write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }

      match /questArchive/{questId} {
        allow read, write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // Public Profiles — leaderboard-readable. Values are authored client-side
    // (offline-first game), so rules cannot prove correctness. We enforce the
    // owner, a strict field allow-list, correct types and sane upper bounds so
    // injected garbage / absurd leaderboard entries (e.g. level 9e18) are
    // rejected. Numbers arrive from the JS SDK as doubles, hence `is number`,
    // not `is int`. Each field is optional so partial merge writes (e.g. the
    // join-guild flow that only sets guildId) still validate.
    match /publicProfiles/{userId} {
      function pf() { return request.resource.data; }
      function numOk(field, max) {
        return !(field in pf())
          || (pf()[field] is number && pf()[field] >= 0 && pf()[field] <= max);
      }

      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && pf().keys().hasOnly([
             'displayName', 'level', 'totalXpEarned', 'totalQuestsCompleted',
             'streak', 'shadowCount', 'dungeonsCleared', 'guildId', 'updatedAt'
           ])
        && (!('displayName' in pf())
            || (pf().displayName is string && pf().displayName.size() <= 60))
        && (!('guildId' in pf())
            || pf().guildId == null || pf().guildId is string)
        && numOk('level', 10000)
        && numOk('totalXpEarned', 1000000000000)
        && numOk('totalQuestsCompleted', 10000000)
        && numOk('streak', 100000)
        && numOk('shadowCount', 100000)
        && numOk('dungeonsCleared', 10000000);
    }

    // Soul Links
    match /soulLinks/{linkCode} {
      // Anyone who knows the linkCode can read and update (join) it
      allow read, update: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Guilds collection
    match /guilds/{guildId} {
      allow read: if request.auth != null;

      // Creator must own the guild and be its first member
      allow create: if request.auth != null
        && request.resource.data.masterId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // The master may change anything in their own guild. Any other member may
      // ONLY join (add self) or leave (remove self) — they cannot rename the guild,
      // hijack masterId, promote themselves, or kick/add other members.
      allow update: if request.auth != null && (
        resource.data.masterId == request.auth.uid

        // JOIN: only memberIds changes, caller adds exactly themselves, guild not full
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= resource.data.maxMembers
        )

        // LEAVE: only membership arrays change, caller removes exactly themselves
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'officerIds'])
          && request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.officerIds.hasAll(request.resource.data.officerIds)
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.masterId;

      // Guild chat messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text.size() <= 200;
        allow update, delete: if false;
      }
    }

    // Global chat collection
    match /globalChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.text.size() <= 200
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // AI usage tracking — written only by Cloud Functions, read by the owning user
    match /aiUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Moderation reports (UGC flagging) — any signed-in user may file a report;
    // only admins may read/triage them (granted via the top-level isAdmin() rule).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.text.size() <= 200;
      allow read, update, delete: if false;
    }

    // Client crash/error logs — a signed-in user may append their own; only
    // admins may read (via the top-level isAdmin() rule).
    match /errorLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
