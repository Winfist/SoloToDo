rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin function to check UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == '4FPoiwjIDneGrJqgYDZLPbPOJZu2';
    }

    // Admin Override: Allow full access to UID 4FPoiwjIDneGrJqgYDZLPbPOJZu2
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection - each user can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // Quest history subcollection (Hybrid Storage)
      match /questHistory/{questId} {
        allow read, write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // Public Profiles
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Soul Links
    match /soulLinks/{linkCode} {
      // Anyone who knows the linkCode can read and update (join) it
      allow read, update: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Guilds collection
    match /guilds/{guildId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Needed so users can join
      allow delete: if request.auth != null && request.auth.uid == resource.data.masterId;

      // Guild chat messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.text.size() <= 200;
        allow update, delete: if false;
      }
    }

    // Global chat collection
    match /globalChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.text.size() <= 200
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // AI usage tracking — written only by Cloud Functions, read by the owning user
    match /aiUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
