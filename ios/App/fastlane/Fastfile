default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci
    
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_P8_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # Clean up old ephemeral certificates since GitHub runners are destroyed after each run
    require 'spaceship'
    Spaceship::ConnectAPI::Certificate.all.each do |c|
      if c.certificate_type.to_s.include?("DISTRIBUTION")
        UI.message("Revoking old certificate: #{c.id}")
        begin
          c.delete!
        rescue => e
          UI.error("Failed to delete certificate: #{e}")
        end
      end
    end

    cert(
      api_key: api_key,
      keychain_path: "~/Library/Keychains/fastlane_tmp_keychain-db",
      keychain_password: ""
    )
    sigh(
      api_key: api_key,
      app_identifier: "com.solotodo.app"
    )
    app_profile_name = ENV["SIGH_NAME"]

    sigh(
      api_key: api_key,
      app_identifier: "com.solotodo.app.widget"
    )
    widget_profile_name = ENV["SIGH_NAME"]

    # Extract the true Team ID safely from Fastlane state or raw profile fallback
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || Dir.glob("../*.mobileprovision").first || Dir.glob("*.mobileprovision").first
    team_id = sh("security cms -D -i '#{profile_path}' 2>/dev/null | grep -A2 'TeamIdentifier' | grep 'string' | sed -E 's/<[^>]+>//g'").strip
    UI.message("Extracted Team ID from Profile: #{team_id}")
    UI.message("App profile name: #{app_profile_name}")
    UI.message("Widget profile name: #{widget_profile_name}")

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"],
      xcodeproj: "App.xcodeproj"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id,
      targets: ["App"],
      profile_name: app_profile_name,
      code_sign_identity: "Apple Distribution"
    )

    # Widget extension code signing (if target exists)
    if widget_profile_name
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        team_id: team_id,
        targets: ["SoloToDoWidgetExtension"],
        profile_name: widget_profile_name,
        code_sign_identity: "Apple Distribution"
      )
    end

    build_app(
      project: "App.xcodeproj", 
      scheme: "App",
      export_method: "app-store",
      export_team_id: team_id,
      cloned_source_packages_path: "SPM"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.solotodo.app",
      skip_waiting_for_build_processing: true
    )
  end
end
