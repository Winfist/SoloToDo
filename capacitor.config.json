{
  "appId": "com.solotodo.app",
  "appName": "SoloToDo",
  "webDir": "dist",
  "server": {
    "hostname": "app.solotodo.com",
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["apple.com", "google.com"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}