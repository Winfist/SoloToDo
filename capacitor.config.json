{
  "appId": "com.solotodo.app",
  "appName": "SoloToDo",
  "webDir": "dist",
  "server": {
    "hostname": "app.solotodo.com",
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["apple.com", "google.com"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/analytics": ["AnalyticsWithoutAdIdSupport"]
        },
        "packageOptions": {
          "@capacitor-firebase/analytics": {
            "symlink": true
          },
          "@capacitor-firebase/authentication": {
            "symlink": true
          },
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
